# Copy to .env locally or enter these keys in Render's Environment dashboard.
# Never commit actual values. The hosted diagnostic does not use a model.
DATABASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENT_BUCKET=finn-sources
PROBE_TOKEN=
PORT=10000
# Local diagnostic client only; fill after Render creates the URL.
PROBE_BASE_URL=

# Gemini API project must have paid billing disabled. No automatic model fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_REQUESTS_PER_DAY=20
GEMINI_REQUESTS_PER_MINUTE=2
